aws_region             = "ap-southeast-1"
project_name           = "knowledgellm-demo"
cognito_domain_prefix  = "choose-a-globally-unique-prefix"
web_origin             = "https://rag.rickchen.si"
web_callback_url       = "https://rag.rickchen.si/"
web_logout_url         = "https://rag.rickchen.si/"
qdrant_url             = "https://your-cluster.example.qdrant.io"

# Optional: If left blank or omitted, Terraform automatically creates free SSM SecureString
# parameters (/knowledgellm-demo/qdrant-api-key and /knowledgellm-demo/groq-api-key)
# with placeholder values. You can update their values with your real keys via AWS Console or CLI.
# qdrant_api_key_secret_arn = ""
# groq_api_key_secret_arn   = ""

# Public fictional demo personas only. Keep false for private production content.
demo_mode = false

# Cache fixed demo answers for the verified hybrid index.
answer_cache_enabled = true
