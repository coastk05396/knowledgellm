aws_region             = "us-east-1"
project_name           = "knowledgellm-demo"
cognito_domain_prefix  = "choose-a-globally-unique-prefix"
web_origin             = "http://localhost:5173"
web_callback_url       = "http://localhost:5173/"
web_logout_url         = "http://localhost:5173/"
qdrant_url             = "https://your-cluster.example.qdrant.io"
qdrant_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:qdrant-key"
groq_api_key_secret_arn   = "arn:aws:secretsmanager:us-east-1:123456789012:secret:groq-key"
