{
  "name": "knowledgellm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "E2E_LIVE_AUTH=1 playwright test",
    "test:e2e:types": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --strict --skipLibCheck playwright.config.ts tests/e2e/*.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lucide-react": "^1.52.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "vitest": "^4.1.11"
  }
}
