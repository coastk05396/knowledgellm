# Copy to `.env.local` for API settings; use `web/.env.local` for Vite settings.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_ISSUER=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/
VITE_API_URL=

# Local API provider settings. Keep actual values in an ignored local .env file.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledgellm-qdrant-multilingual-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-small
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_INPUT_RATE_PER_MILLION_USD=
GROQ_OUTPUT_RATE_PER_MILLION_USD=
